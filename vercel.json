{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!\\.well-known/).*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "club-enrolment-portal.vercel.app"
        }
      ],
      "destination": "https://www.club-registration-portal-center.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!\\.well-known/).*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "club-registration-portal-center.com"
        }
      ],
      "destination": "https://www.club-registration-portal-center.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/html/index1.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/html/join.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/html/join.html?tab=home",
      "permanent": false
    },
    {
      "source": "/club-dashboard",
      "destination": "/html/club_management_dashboard.html",
      "permanent": false
    },
    {
      "source": "/clubs",
      "destination": "/html/msjs.html",
      "permanent": false
    },
    {
      "source": "/booking",
      "destination": "/html/specialty.html",
      "permanent": false
    },
    {
      "source": "/courses",
      "destination": "/html/mfms.html",
      "permanent": false
    },
    {
      "source": "/forum",
      "destination": "/html/spjs.html",
      "permanent": false
    },
    {
      "source": "/support",
      "destination": "/html/tzgg.html",
      "permanent": false
    },
    {
      "source": "/messages",
      "destination": "/html/messages.html",
      "permanent": false
    }
  ]
}
